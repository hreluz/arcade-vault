# Copy to .env (or .env.local) and fill in. Never commit real values.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Team inbox that receives the About page contact messages.
# With the default sender (onboarding@resend.dev), Resend only delivers to
# the email address of the Resend account owner, so use that address here
# until a sending domain is verified.
CONTACT_TO_EMAIL=

# Optional. Sender address. Defaults to "Arcade Vault <onboarding@resend.dev>".
# Must be on a domain verified in Resend if you change it.
CONTACT_FROM_EMAIL=

# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Both are public (inlined into the browser bundle). Use the publishable key
# (sb_publishable_...), never the secret / service-role key. Every table must
# have RLS enabled because this key can do whatever RLS allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
