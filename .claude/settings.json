{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-and-lint.sh",
            "timeout": 60,
            "statusMessage": "Formatting & linting…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "canberra-gtk-play -i complete >/dev/null 2>&1 || aplay -q /usr/share/sounds/alsa/Front_Center.wav >/dev/null 2>&1 || printf '\\a'",
            "async": true
          }
        ]
      }
    ]
  }
}
